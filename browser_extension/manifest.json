{
  "manifest_version": 3,
  "name": "Crown Link Guard",
  "version": "1.0.0",
  "description": "Checks Zoho Desk links before Crown agents open them.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://desk.zoho.com/*", "http://localhost:3000/*", "https://linkguard.crownbs.local/*"],
  "content_scripts": [
    {
      "matches": ["https://desk.zoho.com/*", "https://*.zohodesk.com/*"],
      "js": ["src/config.js", "src/api.js", "src/modal.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Crown Link Guard",
    "default_popup": "public/popup.html"
  }
}
