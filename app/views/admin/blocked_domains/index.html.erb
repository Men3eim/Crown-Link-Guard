<h1>Blocked Domains</h1>

<section class="panel">
  <h2>Add Blocked Domain</h2>
  <%= form_with model: [:admin, @blocked_domain], local: true, class: "form-grid" do |form| %>
    <div class="field"><%= form.label :domain %><%= form.text_field :domain, required: true, placeholder: "booking-secure-payment.com" %></div>
    <div class="field"><%= form.label :severity %><%= form.select :severity, BlockedDomain::SEVERITIES.map { |v| [v, v] } %></div>
    <div class="field"><%= form.label :reason %><%= form.text_field :reason %></div>
    <div class="field"><label><%= form.check_box :active, checked: true %> Active</label></div>
    <%= form.submit "Add", class: "button" %>
  <% end %>
</section>

<section class="panel">
  <table>
    <thead><tr><th>Domain</th><th>Severity</th><th>Active</th><th>Reason</th><th>Manage</th></tr></thead>
    <tbody>
      <% @blocked_domains.each do |domain| %>
        <tr>
          <td><strong><%= domain.domain %></strong></td>
          <td><%= domain.severity %></td>
          <td><%= domain.active? ? "Active" : "Disabled" %></td>
          <td><%= domain.reason.presence || "-" %></td>
          <td>
            <%= form_with model: [:admin, domain], local: true, class: "domain-edit-form" do |form| %>
              <div class="form-grid compact">
                <div class="field"><%= form.label :domain %><%= form.text_field :domain, required: true %></div>
                <div class="field"><%= form.label :severity %><%= form.select :severity, BlockedDomain::SEVERITIES.map { |v| [v, v] } %></div>
                <div class="field"><%= form.label :reason %><%= form.text_field :reason %></div>
                <label class="checkbox"><%= form.check_box :active %> Active</label>
                <%= form.submit "Save changes", class: "button secondary" %>
              </div>
            <% end %>
            <%= button_to "Remove domain", admin_blocked_domain_path(domain), method: :delete, class: "danger", form: { data: { turbo_confirm: "Remove #{domain.domain} from the blocklist?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
