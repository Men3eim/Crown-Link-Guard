<h1>Allowlisted Domains</h1>

<section class="panel">
  <h2>Add Trusted Domain</h2>
  <%= form_with model: [:admin, @allowlisted_domain], local: true, class: "form-grid" do |form| %>
    <div class="field"><%= form.label :domain %><%= form.text_field :domain, required: true, placeholder: "booking.com" %></div>
    <div class="field"><%= form.label :notes %><%= form.text_field :notes %></div>
    <div class="field"><label><%= form.check_box :allow_subdomains %> Allow subdomains</label></div>
    <div class="field"><label><%= form.check_box :active, checked: true %> Active</label></div>
    <%= form.submit "Add", class: "button" %>
  <% end %>
</section>

<section class="panel">
  <table>
    <thead><tr><th>Domain</th><th>Subdomains</th><th>Active</th><th>Notes</th><th>Manage</th></tr></thead>
    <tbody>
      <% @allowlisted_domains.each do |domain| %>
        <tr>
          <td><strong><%= domain.domain %></strong></td>
          <td><%= domain.allow_subdomains? ? "Yes" : "No" %></td>
          <td><%= domain.active? ? "Active" : "Disabled" %></td>
          <td><%= domain.notes.presence || "-" %></td>
          <td>
            <%= form_with model: [:admin, domain], local: true, class: "domain-edit-form" do |form| %>
              <div class="form-grid compact">
                <div class="field"><%= form.label :domain %><%= form.text_field :domain, required: true %></div>
                <div class="field"><%= form.label :notes %><%= form.text_field :notes %></div>
                <label class="checkbox"><%= form.check_box :allow_subdomains %> Allow subdomains</label>
                <label class="checkbox"><%= form.check_box :active %> Active</label>
                <%= form.submit "Save changes", class: "button secondary" %>
              </div>
            <% end %>
            <%= button_to "Remove domain", admin_allowlisted_domain_path(domain), method: :delete, class: "danger", form: { data: { turbo_confirm: "Remove #{domain.domain} from the allowlist?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
